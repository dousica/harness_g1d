<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>lzh_bringup</name>
  <version>0.0.0</version>

  <description>
    Bringup package for G1-D ROS2, MoveIt2 and Unitree SDK2 integration.
  </description>

  <maintainer email="yushu@todo.todo">yushu</maintainer>

  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <exec_depend>lzh_description</exec_depend>
  <exec_depend>lzh_sdk_bridge</exec_depend>
  <exec_depend>lzh_moveit_config</exec_depend>
  <exec_depend>lzh_camera_bridge</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
